APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Local-only: docker compose defaults to these Postgres credentials.
POSTGRES_PASSWORD=pa
DATABASE_URL=postgresql+psycopg://pa:pa@localhost:5432/pa
LANGGRAPH_CHECKPOINT_DB=postgresql+psycopg://pa:pa@localhost:5432/pa

REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Model provider (Groq wins if both are set; unset GROQ_API_KEY to use Nebius).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=60
GROQ_MAX_TOKENS=2048

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=
NEBIUS_TIMEOUT=60
NEBIUS_MAX_TOKENS=2048

# App connections (Composio OAuth). Required for the app catalog to list anything.
COMPOSIO_API_KEY=
COMPOSIO_CALLBACK_URL=

# Proactive schedule (Africa/Nairobi).
INBOX_BRIEFING_HOUR=8
FOLLOWUP_HOUR=16
